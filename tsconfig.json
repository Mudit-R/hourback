{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@hourback/shared": ["packages/shared/src/index.ts"],
      "@hourback/llm": ["packages/llm/src/index.ts"],
      "@hourback/worker": ["apps/worker/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "**/dist/**"]
}
