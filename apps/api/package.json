{
  "name": "@hourback/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "db:migrate": "knex migrate:latest --knexfile src/db/knexfile.ts",
    "db:migrate:rollback": "knex migrate:rollback --knexfile src/db/knexfile.ts",
    "db:seed": "knex seed:run --knexfile src/db/knexfile.ts",
    "db:reset": "knex migrate:rollback --all --knexfile src/db/knexfile.ts && knex migrate:latest --knexfile src/db/knexfile.ts && knex seed:run --knexfile src/db/knexfile.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.10.4",
    "@aws-sdk/client-sqs": "^3.592.0",
    "@graphql-tools/schema": "^10.0.4",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dataloader": "^2.2.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "graphql": "^16.8.1",
    "graphql-subscriptions": "^2.0.0",
    "knex": "^3.1.0",
    "pg": "^8.11.5",
    "uuid": "^9.0.1",
    "zod": "^3.23.8",
    "@hourback/worker": "*"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testMatch": ["**/*.test.ts"],
    "moduleNameMapper": {
      "@hourback/shared": "<rootDir>/../../packages/shared/src/index.ts",
      "@hourback/llm": "<rootDir>/../../packages/llm/src/index.ts",
      "@hourback/worker": "<rootDir>/../../apps/worker/src/index.ts"
    }
  }
}
