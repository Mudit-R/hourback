{
  "name": "@hourback/worker",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "jest --runInBand",
    "dev": "ts-node-dev --respawn --transpile-only src/handler.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.592.0",
    "@hourback/llm": "*",
    "@hourback/shared": "*",
    "dotenv": "^16.4.5",
    "knex": "^3.1.0",
    "pg": "^8.11.5",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.140",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testMatch": ["**/*.test.ts"],
    "moduleNameMapper": {
      "@hourback/shared": "<rootDir>/../../packages/shared/src/index.ts",
      "@hourback/llm": "<rootDir>/../../packages/llm/src/index.ts"
    }
  }
}
