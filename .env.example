# --- Database ---
DATABASE_URL=postgresql://hourback:hourback@localhost:5432/hourback

# --- AWS / Local Queue ---
# Set USE_LOCAL_QUEUE=true to run without AWS / SQS / LocalStack (in-process async queue)
USE_LOCAL_QUEUE=true
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL=http://localhost:4566/000000000000/hourback-comments
SQS_DLQ_URL=http://localhost:4566/000000000000/hourback-comments-dlq

# --- LLM ---
# Values: gemini | anthropic | mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=your_anthropic_key_here

# --- API ---
PORT=4000
NODE_ENV=development
JWT_SECRET=change_me_in_production

# --- Frontend ---
REACT_APP_GRAPHQL_URL=http://localhost:4000/graphql
